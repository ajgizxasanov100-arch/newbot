@dp.message(Form.admin_text)
async def save_text(m: Message, s: FSMContext):
    key, text = m.text.split("|", 1)
    async with aiosqlite.connect("bot.db") as db:
        await db.execute("INSERT OR REPLACE INTO texts(key,value) VALUES(?,?)", (key, text))
        await db.commit()
    await s.clear()
    await m.answer("Сохранено")

