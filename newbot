@dp.message(Form.admin_photo, F.photo)
async def save_photo(m: Message, s: FSMContext):
    key = m.caption
    file_id = m.photo[-1].file_id

    async with aiosqlite.connect("bot.db") as db:
        await db.execute("INSERT OR REPLACE INTO texts(key,photo) VALUES(?,?)", (key, file_id))
        await db.commit()

    await s.clear()
    await m.answer("Фото сохранено")

