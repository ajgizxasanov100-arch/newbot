# ---------- динамический текст ----------
async def send_dynamic(message, key, default, kb=None):
    async with aiosqlite.connect("bot.db") as db:
        cur = await db.execute("SELECT value, photo FROM texts WHERE key=?", (key,))
        row = await cur.fetchone()

    text = default
    photo = None

    if row:
        text = row[0] or default
        photo = row[1]

    if photo:
        await message.answer_photo(photo, caption=text, reply_markup=kb)
    else:
        await message.answer(text, reply_markup=kb)

