# ---------- 1 скрин ----------
@dp.message(Form.wait_1, F.photo)
async def one(m: Message, s: FSMContext):
    await m.react([ReactionTypeEmoji(emoji="👍")])
    await s.set_state(Form.wait_10)
    await s.update_data(count=0)
    await send_dynamic(m, "after_1", "Теперь 10 скринов")

# ---------- 10 скринов ----------
@dp.message(Form.wait_10, F.photo)
async def ten(m: Message, s: FSMContext):
    data = await s.get_data()
    c = data.get("count", 0) + 1

    if c < 10:
        await s.update_data(count=c)
        return await m.answer(f"{c}/10")

    await m.react([ReactionTypeEmoji(emoji="👍")])
    await s.clear()

    async with aiosqlite.connect("bot.db") as db:
        cur = await db.execute("SELECT link FROM channels")
        channels = await cur.fetchall()

    text = "Подпишитесь:\n"
    for ch in channels:
        text += ch[0] + "\n"

    await m.answer(text, reply_markup=check_kb)

# ---------- проверка подписки ----------
@dp.message(F.text == "✅ Проверить")
async def check(m: Message):
    async with aiosqlite.connect("bot.db") as db:
        cur = await db.execute("SELECT link FROM channels")
        channels = await cur.fetchall()

    for ch in channels:
        try:
            member = await bot.get_chat_member(ch[0], m.from_user.id)
            if member.status == "left":
                return await send_dynamic(m, "not_sub", "Не подписан")
        except:
            pass

    await send_dynamic(m, "final",
        "Ожидайте проверку", 
        InlineKeyboardMarkup(
            inline_keyboard=[[InlineKeyboardButton(text="🚀Буст", url="https://t.me/boost/refetorbot")]]
        )
    )

    # уведомление админу (анти-абуз)
    await bot.send_message(ADMIN_ID, f"Новая заявка: {m.from_user.id}")

